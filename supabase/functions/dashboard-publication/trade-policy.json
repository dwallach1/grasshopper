{
  "mode": "autonomous_during_regular_market_hours_after_validation",
  "live_order_policy": "User authorizes autonomous execution after thesis validation without per-trade user approval. Place trades only while the US regular market session is open. Complete the broker review immediately before placement, obey any broker-enforced confirmation requirement that cannot be bypassed, persist every decision, and learn from outcomes.",
  "asset_classes": {
    "equities": true,
    "options": false,
    "crypto": false,
    "margin_or_shorting": false
  },
  "account_state": {
    "source": "robinhood",
    "refresh_before_sizing": true,
    "persist_account_snapshots_to": "supabase.account_snapshots",
    "persist_positions_to": "supabase.portfolio_exposure",
    "max_snapshot_age_seconds": 300,
    "sizing_portfolio_value_field": "total_value",
    "buying_power_field": "buying_power",
    "reject_if_unavailable_or_stale": true
  },
  "sizing": {
    "cash_reserve_percent_of_portfolio_value": 0,
    "max_total_deployed_percent_of_portfolio_value": 100,
    "max_single_trade_percent_of_portfolio_value": 5,
    "max_new_positions_per_run": 3,
    "sizing_method": "percent_of_fresh_broker_equity_with_execution_gates",
    "standing_cash_target_percent": 0,
    "tactical_swing_sleeve": {
      "target_percent_of_portfolio_value": 20,
      "purpose": "Short-horizon, catalyst-driven swing trades that pass every validation and execution gate.",
      "target_positions": 2,
      "max_percent_per_position": 5,
      "allow_transient_cash_only_when_market_closed_or_no_candidate_passes_gates": true,
      "re_screen_transient_cash_at_next_regular_session": true
    },
    "default_max_thesis_percent_of_portfolio_value": 5
  },
  "swing_filters": {
    "time_horizon": "days_to_weeks",
    "require_robinhood_symbol_validation": true,
    "require_clear_catalyst_or_dislocation": true,
    "require_invalidation_note": true,
    "penalize_existing_cross_account_exposure": true,
    "allow_event_trades": true,
    "avoid_buying_within_days_before_earnings_without_explicit_event_trade_thesis": 0
  },
  "review_process": {
    "use_subagents": true,
    "required_reviews": ["bull_case", "bear_case", "portfolio_risk"],
    "persist_postmortems": true,
    "harden_or_soften_theses_after_outcomes": true,
    "allow_web_research": true
  },
  "order_defaults": {
    "side": "buy",
    "type": "market",
    "market_hours": "regular_hours",
    "time_in_force": "gfd",
    "use_fractional_dollar_orders": true
  },
  "execution_gates": {
    "require_user_approval_per_trade": false,
    "require_us_regular_market_open": true,
    "autonomous_execution_window_start": "09:45",
    "autonomous_execution_window_end": "15:45",
    "regular_session_timezone": "America/New_York",
    "regular_session_start": "09:30",
    "regular_session_end": "16:00",
    "review_fresh_quote_immediately_before_placement": true,
    "max_quote_age_seconds": 120,
    "max_spread_bps": 80,
    "max_trades_per_day": 3,
    "max_daily_notional_percent_of_portfolio_value": 20,
    "max_single_live_trade_percent_of_portfolio_value": 5,
    "fail_closed_on_any_broker_alert": true,
    "require_new_version_4_ref_id_per_logical_order": true
  },
  "position_management": {
    "authorized_actions": ["hold", "add", "reduce", "exit"],
    "require_user_approval_per_action": false,
    "review_schedule": ["10:05", "13:05", "15:25"],
    "hard_loss_exit_percent": 8,
    "max_total_position_percent_of_portfolio_value": 5,
    "max_add_percent_of_portfolio_value_per_review": 2,
    "max_adds_per_position_lifetime": 2,
    "max_adds_per_position_per_day": 1,
    "minimum_hours_between_adds": 24,
    "allow_averaging_down": false,
    "reduce_percent_min": 25,
    "reduce_percent_max": 50,
    "max_reductions_per_position_per_day": 1,
    "require_deterministic_adverse_evidence_for_thesis_exit_or_reduce": true,
    "risk_reducing_sells_bypass_buy_count_and_buy_notional_caps": true,
    "same_symbol_pending_order_blocks_new_action": true
  }
}
