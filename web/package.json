{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "bun --bun vinext dev",
    "build": "bun --bun vinext build",
    "start": "bun --bun vinext start",
    "dashboard:dry-run": "bun run build && WRANGLER_LOG_PATH=.wrangler/logs bun --bun wrangler deploy --config wrangler.json --cwd dist/server --dry-run",
    "dashboard:deploy": "bun run build && WRANGLER_LOG_PATH=.wrangler/logs bun --bun wrangler deploy --config wrangler.json --cwd dist/server",
    "lint": "bun --bun eslint . --ignore-pattern dist --ignore-pattern .next",
    "research:types": "WRANGLER_LOG_PATH=.wrangler/logs bun --bun wrangler types --config wrangler.research.jsonc --include-runtime false worker-research-configuration.d.ts",
    "workflow:typecheck": "bun --bun tsc --project workflows/tsconfig.json",
    "workflow:test": "bun test workflows/market-clock.test.ts workflows/autonomous-decision.test.ts workflows/position-decision.test.ts",
    "research:dry-run": "WRANGLER_LOG_PATH=.wrangler/logs bun --bun wrangler deploy --config wrangler.research.jsonc --dry-run",
    "research:deploy": "WRANGLER_LOG_PATH=.wrangler/logs bun --bun wrangler deploy --config wrangler.research.jsonc",
    "knowledge:types": "WRANGLER_LOG_PATH=.wrangler/logs bun --bun wrangler types --config wrangler.knowledge.jsonc --include-runtime false worker-knowledge-configuration.d.ts",
    "knowledge:typecheck": "bun --bun tsc --project knowledge/tsconfig.json",
    "knowledge:test": "bun test knowledge/knowledge.test.ts",
    "knowledge:dry-run": "WRANGLER_LOG_PATH=.wrangler/logs bun --bun wrangler deploy --config wrangler.knowledge.jsonc --dry-run",
    "knowledge:deploy": "WRANGLER_LOG_PATH=.wrangler/logs bun --bun wrangler deploy --config wrangler.knowledge.jsonc",
    "broker:types": "WRANGLER_LOG_PATH=.wrangler/logs bun --bun wrangler types --config wrangler.broker.jsonc --include-runtime false worker-broker-configuration.d.ts",
    "broker:typecheck": "bun --bun tsc --project workflows/tsconfig.broker.json",
    "broker:test": "bun test workflows/robinhood-broker-agent.test.ts workflows/broker-execution-policy.test.ts",
    "broker:oauth-relay": "bun scripts/robinhood-oauth-relay.ts",
    "broker:dry-run": "WRANGLER_LOG_PATH=.wrangler/logs bun --bun wrangler deploy --config wrangler.broker.jsonc --dry-run",
    "broker:deploy": "WRANGLER_LOG_PATH=.wrangler/logs bun --bun wrangler deploy --config wrangler.broker.jsonc",
    "cloud:trigger": "bun --bun wrangler workflows trigger thesisforge-research-cycle --config wrangler.research.jsonc --params '{\"force\":true,\"requestedBy\":\"manual\"}'",
    "cloud:tail": "bun --bun wrangler tail thesisforge-research-orchestrator --config wrangler.research.jsonc"
  },
  "dependencies": {
    "agents": "0.20.0",
    "jose": "6.2.10",
    "next": "16.2.6",
    "pg": "8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260823.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  },
  "type": "module"
}
