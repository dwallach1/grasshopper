{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thesisforge-dashboard-publication",
  "main": "workflows/cloud-native-control.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": [
      "SUPABASE_URL",
      "THESISFORGE_PUBLICATION_TOKEN"
    ]
  },
  "workflows": [
    {
      "binding": "DASHBOARD_PUBLICATION",
      "name": "thesisforge-dashboard-publication",
      "class_name": "DashboardPublicationWorkflow"
    },
    {
      "binding": "CLOUD_RESEARCH_CYCLE",
      "name": "thesisforge-cloud-research-cycle",
      "class_name": "CloudResearchWorkflow"
    }
  ],
  "triggers": {
    "crons": [
      "5 14,15 * * 1-5",
      "5 17,18 * * 1-5",
      "25 19,20 * * 1-5"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_GATEWAY_ID": "default",
    "TRADING_ENABLED": "true",
    "BROKER_GATEWAY_MODE": "robinhood_mcp"
  },
  "queues": {
    "producers": [
      {
        "binding": "RESEARCH_TASK_QUEUE",
        "queue": "thesisforge-research-tasks"
      }
    ],
    "consumers": [
      {
        "queue": "thesisforge-research-tasks",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_retries": 4,
        "dead_letter_queue": "thesisforge-research-tasks-dlq",
        "max_concurrency": 2,
        "retry_delay": 60
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "THESIS_COORDINATOR",
        "class_name": "ThesisCoordinator"
      },
      {
        "name": "POSITION_MONITOR",
        "class_name": "PositionMonitor"
      },
      {
        "name": "BROKER_EXECUTION_COORDINATOR",
        "class_name": "BrokerExecutionCoordinator"
      },
      {
        "name": "ROBINHOOD_BROKER_AGENT",
        "class_name": "RobinhoodBrokerAgent",
        "script_name": "thesisforge-broker-gateway"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-cloud-native-control",
      "new_sqlite_classes": [
        "ThesisCoordinator",
        "PositionMonitor",
        "BrokerExecutionCoordinator"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
