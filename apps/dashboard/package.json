{
  "name": "@quantanamo/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "bun --bun next dev --hostname 0.0.0.0 --port 5173",
    "build": "bun --bun next build",
    "start": "bun --bun next start --hostname 0.0.0.0 --port 5173",
    "lint": "bun run lint:eslint && bun run lint:anti-slop",
    "lint:eslint": "bun --bun eslint . --ignore-pattern .next",
    "lint:anti-slop": "bun --bun oxlint .",
    "test": "bun test lib",
    "typecheck": "bun --bun tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dicebear/core": "9.2.4",
    "@dicebear/lorelei": "9.2.4",
    "@quantanamo/contracts": "workspace:*",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "next": "16.2.6",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1",
    "zod": "^4"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "oxlint": "1.80.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  }
}
