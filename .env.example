# X / Twitter developer app credentials.
# Do not put real secrets in this file. Copy to .env.local and fill that in.

# OAuth 2.0 client id. In the X developer portal this may be shown separately
# from the OAuth 1.0a Consumer Key.
X_CLIENT_ID=

# OAuth 2.0 client secret, if your app is configured as a confidential client.
# For a public PKCE app this may be empty.
X_CLIENT_SECRET=

# Redirect URI registered in the X developer portal.
X_REDIRECT_URI=http://127.0.0.1:3000/callback

# Optional: OAuth 1.0a app credentials. These are not sufficient by themselves
# for reading private bookmarks via the v2 OAuth 2.0 bookmarks flow.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=

# Optional: app-only bearer token. This is not enough for private bookmarks.
X_BEARER_TOKEN=

# Filled by the local OAuth flow after you authorize your own X account.
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=

# Financial Datasets paid API. Requests are made only by the local cache-first
# ingestion command; the key is never shipped to the web application.
FINANCIAL_DATASETS_API_KEY=

# Canonical Supabase Postgres database. Use the transaction pooler for short
# scheduled runs, and append sslmode=require.
QUANTANAMO_DATABASE_URL=

# Server-only values used by the local dashboard (`bun run web:app`).
# Never prefix the secret with NEXT_PUBLIC_ or expose it in browser code.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
LOCAL_DEV_IDENTITY=local@quantanamo.dev
QUANTANAMO_MANAGER_USER_IDS=local@quantanamo.dev
# Optional: needed for ontology promote/demote from the local desk
QUANTANAMO_DASHBOARD_TOKEN=
QUANTANAMO_MANAGER_TOKEN=

# Optional: adhoc Worker triggers from the local desk Run button (server-side only).
# After deploy with workers_dev, use your *.workers.dev URLs (see wrangler.jsonc name).
INTERNAL_SERVICE_TOKEN=
QUANTANAMO_KNOWLEDGE_WORKER_URL=https://quantanamo-knowledge-pipeline.davidwallach2.workers.dev
QUANTANAMO_RESEARCH_WORKER_URL=https://quantanamo-research-orchestrator.davidwallach2.workers.dev

# Private bucket used for immutable PDFs, filings, transcripts, and selected
# article snapshots. Override only if the bucket was provisioned under a
# different name.
QUANTANAMO_RESEARCH_BUCKET=research-originals
