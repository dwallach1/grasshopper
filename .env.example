# X / Twitter developer app credentials.
# Do not put real secrets in this file. Copy to .env.local and fill that in.

# OAuth 2.0 client id. In the X developer portal this may be shown separately
# from the OAuth 1.0a Consumer Key.
X_CLIENT_ID=

# OAuth 2.0 client secret, if your app is configured as a confidential client.
# For a public PKCE app this may be empty.
X_CLIENT_SECRET=

# Redirect URI registered in the X developer portal.
X_REDIRECT_URI=http://127.0.0.1:3000/callback

# Optional: OAuth 1.0a app credentials. These are not sufficient by themselves
# for reading private bookmarks via the v2 OAuth 2.0 bookmarks flow.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=

# Optional: app-only bearer token. This is not enough for private bookmarks.
X_BEARER_TOKEN=

# Filled by the local OAuth flow after you authorize your own X account.
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=

# Financial Datasets paid API. Requests are made only by the local cache-first
# ingestion command; the key is never shipped to the web application.
FINANCIAL_DATASETS_API_KEY=
