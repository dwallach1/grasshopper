{
  "name": "thesisforge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "type": "module",
  "scripts": {
    "setup:python": "python3 -m venv .venv && .venv/bin/python -m pip install -e .",
    "cli": ".venv/bin/python -m thesisforge",
    "x:auth": "bun scripts/x/x-oauth.mjs",
    "x:bookmarks": "bun scripts/x/x-bookmarks.mjs",
    "thesis:report": ".venv/bin/python -m thesisforge report thesis",
    "articles:fetch": ".venv/bin/python -m thesisforge articles fetch",
    "thesis:refresh": "bun run x:bookmarks && bun run articles:fetch && bun run thesis:report",
    "ontology:refresh": ".venv/bin/python -m thesisforge ontology refresh",
    "ontology:report": ".venv/bin/python -m thesisforge ontology report",
    "dashboard:publish": ".venv/bin/python -m thesisforge dashboard publish",
    "financial:plan": ".venv/bin/python -m thesisforge financial pilot GEV VST CEG",
    "financial:fetch": ".venv/bin/python -m thesisforge financial fetch",
    "financial:stats": ".venv/bin/python -m thesisforge financial stats",
    "financial:test": ".venv/bin/python -m unittest tests/test_financial_data.py",
    "policy:test": ".venv/bin/python -m unittest tests/test_trade_policy.py",
    "test": ".venv/bin/python -m unittest discover -s tests",
    "supabase:verify": ".venv/bin/python -m thesisforge supabase verify-worker",
    "research:capture": ".venv/bin/python -m thesisforge research capture",
    "event-map:sunday": ".venv/bin/python -m thesisforge event-map sunday",
    "run:report": ".venv/bin/python -m thesisforge report run",
    "research:refresh": "bun run thesis:refresh && bun run ontology:refresh && bun run dashboard:publish && bun run ontology:report"
  }
}
