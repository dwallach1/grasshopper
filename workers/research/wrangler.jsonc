{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "thesisforge-research-orchestrator",
  "main": "src/research-orchestrator.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "secrets_store_secrets": [{
    "binding": "THESISFORGE_PUBLICATION_TOKEN_SECRET",
    "store_id": "9161ea4b738144c0accc37e724812d93",
    "secret_name": "THESISFORGE_PUBLICATION_TOKEN"
  }, {
    "binding": "INTERNAL_SERVICE_TOKEN_SECRET",
    "store_id": "9161ea4b738144c0accc37e724812d93",
    "secret_name": "INTERNAL_SERVICE_TOKEN"
  }],
  "secrets": { "required": ["SUPABASE_URL"] },
  "workflows": [{
    "binding": "CLOUD_RESEARCH_CYCLE",
    "name": "thesisforge-research-cycle",
    "class_name": "CloudResearchWorkflow"
  }],
  "triggers": { "crons": ["5 14,15,19,20 * * MON-FRI"] },
  "ai": { "binding": "AI" },
  "vars": {
    "AI_GATEWAY_ID": "default",
    "TRADING_ENABLED": "true",
    "BROKER_GATEWAY_MODE": "robinhood_mcp"
  },
  "queues": {
    "producers": [{ "binding": "RESEARCH_TASK_QUEUE", "queue": "thesisforge-research-tasks" }],
    "consumers": [{
      "queue": "thesisforge-research-tasks",
      "max_batch_size": 5,
      "max_batch_timeout": 10,
      "max_retries": 4,
      "dead_letter_queue": "thesisforge-research-tasks-dlq",
      "max_concurrency": 2,
      "retry_delay": 60
    }]
  },
  "durable_objects": { "bindings": [
    { "name": "THESIS_COORDINATOR", "class_name": "ThesisCoordinator" },
    { "name": "POSITION_MONITOR", "class_name": "PositionMonitor" },
    { "name": "BROKER_EXECUTION_COORDINATOR", "class_name": "BrokerExecutionCoordinator" },
    { "name": "ROBINHOOD_BROKER_AGENT", "class_name": "RobinhoodBrokerAgent", "script_name": "thesisforge-broker-gateway" }
  ] },
  "exports": {
    "ThesisCoordinator": { "type": "durable-object", "storage": "sqlite" },
    "PositionMonitor": { "type": "durable-object", "storage": "sqlite" },
    "BrokerExecutionCoordinator": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
